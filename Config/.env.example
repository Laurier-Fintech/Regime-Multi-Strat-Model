# =============================================================================
# Secrets template (Config/.env.example). This file IS committed. No real values.
# To use: copy this file to Config/.env and fill in the values there.
# Config/.env is listed in .gitignore and must NEVER be committed.
# =============================================================================

# --- FRED (macro + credit data: Treasury yields, HY OAS, T-bills) -----------
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Interactive Brokers (live data + trading) ------------------------------
# Your IBKR username and password are typed into TWS / IB Gateway, NOT here.
# The code connects to TWS / IB Gateway running on your own machine.
IBKR_HOST=127.0.0.1
# Default ports: TWS paper 7497, TWS live 7496, Gateway paper 4002, Gateway live 4001
IBKR_PORT=7497
IBKR_CLIENT_ID=1
# Account IDs are shown in TWS (paper accounts usually start with "DU")
IBKR_PAPER_ACCOUNT_ID=
IBKR_LIVE_ACCOUNT_ID=

# --- Historical options data (source NOT decided yet) -----------------------
# Fill in only once a provider is chosen (e.g. WRDS / OptionMetrics via Laurier).
# WRDS_USERNAME=
# WRDS_PASSWORD=
